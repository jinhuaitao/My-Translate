{
  "name": "ai-translate",
  "private": true,
  "version": "1.2.0",
  "description": "基于 Cloudflare Workers 的多语言随身翻译 PWA：支持自定义 API_URL / API_KEY / MODEL 流式翻译、拍照 OCR、朗读、离线外壳",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --keep-vars",
    "check": "wrangler deploy --dry-run --outdir=.wrangler/dry-run",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "^4",
    "@cloudflare/workers-types": "^4"
  }
}
