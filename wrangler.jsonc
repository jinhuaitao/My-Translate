{
  // Cloudflare Workers 配置文件
  // 连接 GitHub 部署（Workers Builds）或本地执行 `npm run deploy` 时会自动读取本文件。

  "$schema": "node_modules/wrangler/config-schema.json",

  // Worker 名称：Dashboard 里连接的 Worker 名请与此保持一致，
  // 否则构建产物会被部署到另一个同名 Worker 上。
  "name": "ai-translate",

  // 入口文件（模块化 Worker，export default { fetch }）
  "main": "worker.js",

  // 兼容日期：决定 Workers 运行时行为
  "compatibility_date": "2026-10-15",

  // 保留 workers.dev 子域访问
  "workers_dev": true,

  // ★ 关键配置：保留云端已添加的环境变量！
  // 设为 true 后，每次执行 `wrangler deploy`（包括 GitHub 自动部署）时，
  // 不会清空或删除你在 Cloudflare Dashboard 控制台里手动添加的 API_URL、API_KEY、MODEL 等环境变量。
  // 同时请注意：不要在下方的 "vars" 中定义 API_URL、API_KEY 或 MODEL，否则本地同名字段会覆盖云端值。
  "keep_vars": true,

  // 开启线上日志 + 源码映射，异常堆栈能还原到 worker.js 的真实行号。
  // 配合 package.json 里的 `npm run tail` 可实时查看日志。
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // Workers AI 绑定：保留用于 /api/tts 语音合成功能（不调用不产生费用）
  "ai": {
    "binding": "AI"
  }

  // 翻译环境变量说明（请在 Cloudflare Dashboard -> Settings -> Variables and Secrets 中添加）：
  //   - API_URL : 外部大模型接口地址（如 https://api.openai.com/v1/chat/completions 或 https://api.deepseek.com）
  //   - API_KEY : 接口密钥（建议类型选择 Secret 加密存储）
  //   - MODEL   : 模型名称（如 gpt-4o-mini 或 deepseek-chat，支持逗号分隔多个备选模型）
  // 本地开发（npm run dev）时，可在项目根目录创建 .dev.vars 文件配置上述三个变量。
}
