{
  // Cloudflare Workers 配置文件
  // 连接 GitHub 部署（Workers Builds）时，构建流程执行 `npx wrangler deploy`，
  // 会自动读取本文件 —— 所以这里的绑定会「跟着部署一起生效」，无需再去控制台手点。

  "$schema": "node_modules/wrangler/config-schema.json",

  // Worker 名称：Dashboard 里连接的 Worker 名请与此保持一致，
  // 否则构建产物会被部署到另一个同名 Worker 上。
  "name": "ai-translate",

  // 入口文件（模块化 Worker，export default { fetch }）
  "main": "worker.js",

  // 兼容日期：决定 Workers 运行时行为，建议等于首次创建日期
  "compatibility_date": "2026-10-15",

  // 保留 workers.dev 子域访问（不配置则需自定义域名才能访问）
  "workers_dev": true,

  // 开启线上日志 + 源码映射，异常堆栈能还原到 worker.js 的真实行号。
  // 配合 package.json 里的 `npm run tail` 可实时查看日志。
  "observability": { "enabled": true },
  "upload_source_maps": true,

  // ★ 关键：Workers AI 绑定
  // 写成这样即可，不需要在控制台创建任何资源、不产生额外费用
  // （只有真正调用 env.AI.run() 时才按 token 计费）。
  // 部署后 env.AI 就可用，对应 worker.js 里的 env.AI.run(...)。
  "ai": {
    "binding": "AI"
  },

  // 运行时变量：换模型只改这里 + 重新部署，worker.js 不用动。
  // 留空字符串时 worker.js 会回退到内置的 DEFAULT_MODEL。
  "vars": {
    "MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",

    // 排障开关：设为 "1" 后，/api/tts 失败时响应会附带模型真实报错（detail 字段），
    // 前端 toast 同步显示，便于定位「语音合成失败」的具体原因；排查完建议改回 "0"。
    "TTS_DEBUG": "0"
  }
}
